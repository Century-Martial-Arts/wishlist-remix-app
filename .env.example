# Copy to .env for local development. Never commit .env.
# Values marked "from CLI" are usually injected by `shopify app dev`.

# Postgres connection string for Prisma (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Shopify app credentials (from CLI during `shopify app dev`, or from Partners for hosted runs)
SHOPIFY_API_KEY="<YOUR_SHOPIFY_API_KEY>"
SHOPIFY_API_SECRET="<YOUR_SHOPIFY_API_SECRET>"
SHOPIFY_APP_URL="<YOUR_APP_URL>"
SCOPES="read_products,unauthenticated_read_product_listings,write_products"

# Optional: custom shop domain for shops that do not use *.myshopify.com
# SHOP_CUSTOM_DOMAIN="<YOUR_CUSTOM_SHOP_DOMAIN>"
